+        // cannot overlap them (controller.sv lines 43 to 45 and 124 to
+        // 128), so the two durations add rather than replace.
+        reschedule(fenceFlushClearEvent,
+                   fenceFlushClearEvent.when() + cyclesToTicks(walk));
+    } else {
+        setBlocked(Blocked_FenceFlush);
+        schedule(fenceFlushClearEvent, clockEdge(walk));
+    }
+}
