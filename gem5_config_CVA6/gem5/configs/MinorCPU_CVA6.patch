+void
+LSQ::signalFenceDcache()
+{
+    /* CVA6 raises flush_dcache_o from commit (controller.sv), a
+     *  control wire and not a port transaction, so the signal goes
+     *  functionally and costs no bandwidth. Off by default. */
+    if (fenceSignalsDcache) {
+        RequestPtr fence_req = std::make_shared<Request>(
+            0, 0, 0, Request::funcRequestorId);
+        Packet fence_pkt(fence_req, MemCmd::FlushReq);
+        dcachePort.sendFunctional(&fence_pkt);
+    }
+}
