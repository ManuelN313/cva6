+Cycles
+BaseCache::fillHold(const PacketPtr pkt) const
+{
+    Cycles hold = fillDelay;
+    if (windowAcceptAndCharge) {
+        // A miss response carries its MSHR as the top sender state. Write
+        // responses carry a write-queue entry, which casts to null.
+        const MSHR *mshr = dynamic_cast<const MSHR*>(pkt->senderState);
+        if (mshr) {
+            hold += mshr->windowCharge;
+        }
+    }
+    return hold;
+}
+
+void
+BaseCache::scheduleDeferredFill(PacketPtr pkt, Cycles hold)
+{
+    const Tick ready = clockEdge(hold);
+    // Holds differ per response under accept-and-charge, so the queue is
+    // kept ordered by release tick, arrival order among equals.
+    auto pos = deferredFills.begin();
+    while (pos != deferredFills.end() && pos->first <= ready) {
+        ++pos;
+    }
+    deferredFills.emplace(pos, ready, pkt);
+    if (!deferredFillEvent.scheduled()) {
+        schedule(deferredFillEvent, deferredFills.front().first);
+    } else if (deferredFillEvent.when() > deferredFills.front().first) {
+        reschedule(deferredFillEvent, deferredFills.front().first);
+    }
+}
+
+void
+BaseCache::processDeferredFills()
+{
+    while (!deferredFills.empty() &&
+           deferredFills.front().first <= curTick()) {
+        PacketPtr pkt = deferredFills.front().second;
+        deferredFills.pop_front();
+        recvTimingResp(pkt);
+    }
+    if (!deferredFills.empty()) {
+        schedule(deferredFillEvent, deferredFills.front().first);
+    }
+}
