+
+/* HPDcachePLRU implementation. See hpdcache_plru_rp.hh for the V-rule
+ * summary. The shared-state pattern follows TreePLRU and the candidate
+ * downcast mirrors BaseSetAssoc's own (base_set_assoc.hh line 186). */
+
+#include "mem/cache/replacement_policies/hpdcache_plru_rp.hh"
+
+#include <cassert>
+
+#include "mem/cache/cache_blk.hh"
+
+namespace gem5
+{
+
+namespace replacement_policy
+{
+
+HPDcachePLRU::HPDcachePLRU(const Params &p)
+    : Base(p), numWays(p.num_ways), count(0), sharedBits(nullptr)
+{
+}
+
+void
+HPDcachePLRU::invalidate(
+    const std::shared_ptr<ReplacementData>& replacement_data)
+{
+    // Transcription no-op: V2 is the only writer of the use bits and
+    // tier 1 of V3 catches invalid ways before the bits are consulted.
+}
+
+void
+HPDcachePLRU::touch(
+    const std::shared_ptr<ReplacementData>& replacement_data) const
+{
+    // Rule V2 (hpdcache_victim_plru.sv lines 120 to 129): set the
+    // accessed way's bit, and if the set would saturate to all ones,
+    // reset to only the accessed way's bit.
+    const auto data =
+        std::static_pointer_cast<HPDcacheReplData>(replacement_data);
+    std::vector<bool> &bits = data->bits->bits;
+
+    bits[data->index] = true;
+
+    bool all_set = true;
+    for (const bool b : bits) {
+        all_set = all_set && b;
+    }
+    if (all_set) {
+        for (uint64_t i = 0; i < bits.size(); i++) {
+            bits[i] = (i == data->index);
+        }
+    }
+}
+
+void
+HPDcachePLRU::reset(
+    const std::shared_ptr<ReplacementData>& replacement_data) const
+{
+    // Transcription no-op, rule V4: no update at miss allocation. The
+    // refill update arrives through the fill-path replTouch hook.
+}
+
+ReplaceableEntry*
+HPDcachePLRU::getVictim(const ReplacementCandidates& candidates) const
+{
+    assert(candidates.size() > 0);
+
+    // Rule V3 (hpdcache_victim_plru.sv lines 72 to 115). Candidates arrive
+    // from the indexing policy in way order, so keeping the first match per
+    // tier is the priority one-hot encoder.
+    ReplaceableEntry *unused_way = nullptr;
+    ReplaceableEntry *plru_way = nullptr;
+    ReplaceableEntry *clean_way = nullptr;
+    ReplaceableEntry *dirty_way = nullptr;
+
+    for (const auto& candidate : candidates) {
+        CacheBlk *blk = static_cast<CacheBlk*>(candidate);
+
+        // sel_dir_fetch exclusion: a way with a fill in flight is the
+        // valid-but-not-readable transient of evict-at-allocate. A reserved
+        // victim stays readable, so it carries an explicit marker instead.
+        const bool fetching =
+            (blk->isValid() && !blk->isSet(CacheBlk::ReadableBit)) ||
+            blk->isReservedVictim();
+        if (fetching) {
+            continue;
+        }
+
+        if (!blk->isValid()) {
+            if (!unused_way) {
+                unused_way = candidate;
+            }
+            continue;
+        }
+
+        const auto data = std::static_pointer_cast<HPDcacheReplData>(
+            candidate->replacementData);
+        if (!data->bits->bits[data->index] && !plru_way) {
+            plru_way = candidate;
+        }
+        if (!blk->isSet(CacheBlk::DirtyBit)) {
+            if (!clean_way) {
+                clean_way = candidate;
+            }
+        } else if (!dirty_way) {
+            dirty_way = candidate;
+        }
+    }
+
+    if (unused_way) {
+        return unused_way;
+    }
+    if (plru_way) {
+        return plru_way;
+    }
+    if (clean_way) {
+        return clean_way;
+    }
+    if (dirty_way) {
+        return dirty_way;
+    }
+
+    // Every way has a fill in flight. The RTL outputs no victim and replays
+    // (line 113). Nominating way 0 lets the reservation guard refuse it,
+    // driving the counted graceful fallback, the gem5 twin of the replay.
+    return candidates[0];
+}
+
+std::shared_ptr<ReplacementData>
+HPDcachePLRU::instantiateEntry()
+{
+    // A bit vector is shared by numWays consecutive entries, the
+    // TreePLRU sharing pattern (tree_plru_rp.cc lines 199 to 213).
+    if (count % numWays == 0) {
+        sharedBits = std::make_shared<PLRUBits>(numWays);
+    }
+
+    auto data = std::shared_ptr<HPDcacheReplData>(
+        new HPDcacheReplData(count % numWays, sharedBits));
+    count++;
+    return data;
+}
+
+} // namespace replacement_policy
+} // namespace gem5
