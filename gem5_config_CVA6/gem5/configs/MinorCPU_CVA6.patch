+
+/* HPDcacheRandom implementation. See hpdcache_random_rp.hh for the rule
+ * set. The candidate downcast mirrors BaseSetAssoc's own
+ * (base_set_assoc.hh line 186), as in the PLRU sibling. */
+
+#include "mem/cache/replacement_policies/hpdcache_random_rp.hh"
+
+#include <cassert>
+
+#include "base/intmath.hh"
+#include "base/logging.hh"
+
+#include "mem/cache/cache_blk.hh"
+
+namespace gem5
+{
+
+namespace replacement_policy
+{
+
+HPDcacheRandom::HPDcacheRandom(const Params &p)
+    : Base(p),
+      // R5: reset value all ones (hpdcache_lfsr.sv line 79)
+      lfsr(0xFF),
+      hpdcacheRandomStats(this)
+{
+}
+
+HPDcacheRandom::HPDcacheRandomStats::HPDcacheRandomStats(
+    statistics::Group *parent)
+    : statistics::Group(parent),
+      ADD_STAT(unusedTier, statistics::units::Count::get(),
+               "victims taken from the unused tier, no LFSR shift"),
+      ADD_STAT(randomTier, statistics::units::Count::get(),
+               "victims taken from the random tier, one LFSR shift"),
+      ADD_STAT(cleanTier, statistics::units::Count::get(),
+               "victims taken from the clean tier"),
+      ADD_STAT(dirtyTier, statistics::units::Count::get(),
+               "victims taken from the dirty tier"),
+      ADD_STAT(noVictim, statistics::units::Count::get(),
+               "selections with every way in flight, the RTL replay arm")
+{
+}
+
+void
+HPDcacheRandom::invalidate(
+    const std::shared_ptr<ReplacementData>& replacement_data)
+{
+}
+
+void
+HPDcacheRandom::touch(
+    const std::shared_ptr<ReplacementData>& replacement_data) const
+{
+}
+
+void
+HPDcacheRandom::reset(
+    const std::shared_ptr<ReplacementData>& replacement_data) const
+{
+}
+
+ReplaceableEntry*
+HPDcacheRandom::getVictim(const ReplacementCandidates& candidates) const
+{
+    assert(candidates.size() > 0);
+    const int ways = candidates.size();
+
+    // The RTL decodes the low wayIndexWidth bits of the LFSR into a one-hot
+    // vector (hpdcache_victim_random.sv lines 83 to 88), so the hardware
+    // supports powers of two only, hence the check rather than a modulo.
+    fatal_if(!isPowerOf2(ways),
+             "HPDcacheRandom needs a power-of-two associativity, got %d. "
+             "The transcribed policy decodes LFSR bits directly onto "
+             "ways, as the RTL does.", ways);
+
+    // Candidates arrive in way order, so first-match scans are the priority
+    // encoders. Tier masks per hpdcache_victim_random.sv lines 68 to 71,
+    // with fetching mapped to the reserved valid-but-not-readable transient.
+    ReplaceableEntry *unused_way = nullptr;
+    ReplaceableEntry *clean_way = nullptr;
+    ReplaceableEntry *dirty_way = nullptr;
+    ReplaceableEntry *rand_way = nullptr;
+
+    const int rand_index = lfsr & (ways - 1);
+
+    for (int w = 0; w < ways; w++) {
+        CacheBlk *blk = static_cast<CacheBlk*>(candidates[w]);
+        // A way is out of the running while its line is in flight. The
+        // reserved victim stays readable under the victim-readable lever, so
+        // it carries an explicit marker instead.
+        const bool fetching =
+            (blk->isValid() && !blk->isSet(CacheBlk::ReadableBit)) ||
+            blk->isReservedVictim();
+        if (fetching) {
+            continue;
+        }
+        if (!blk->isValid()) {
+            if (!unused_way) {
+                unused_way = candidates[w];
+            }
+            continue;
+        }
+        if (w == rand_index) {
+            rand_way = candidates[w];
+        }
+        if (!blk->isSet(CacheBlk::DirtyBit)) {
+            if (!clean_way) {
+                clean_way = candidates[w];
+            }
+        } else if (!dirty_way) {
+            dirty_way = candidates[w];
+        }
+    }
+
+    // R1: unused first. The LFSR does not shift in this case
+    // (shift_i carries ~unused_available).
+    if (unused_way) {
+        hpdcacheRandomStats.unusedTier++;
+        return unused_way;
+    }
+
+    // R2 and R5: the LFSR-named way if eligible, and the register
+    // shifts exactly on this firing (Galois right, polynomial 0xE1,
+    // hpdcache_lfsr.sv lines 50 and 63 to 71).
+    if (rand_way) {
+        hpdcacheRandomStats.randomTier++;
+        const uint8_t lsb = lfsr & 0x1;
+        lfsr = lfsr >> 1;
+        if (lsb) {
+            lfsr ^= 0xE1;
+        }
+        return rand_way;
+    }
+
+    // R3 then R4.
+    if (clean_way) {
+        hpdcacheRandomStats.cleanTier++;
+        return clean_way;
+    }
+    if (dirty_way) {
+        hpdcacheRandomStats.dirtyTier++;
+        return dirty_way;
+    }
+
+    // Every way has a fill in flight. The RTL outputs no victim and replays
+    // (default arm, line 123). Nominating way 0 lets the guard refuse it,
+    // driving the counted graceful fallback, as in the PLRU sibling.
+    hpdcacheRandomStats.noVictim++;
+    return candidates[0];
+}
+
+std::shared_ptr<ReplacementData>
+HPDcacheRandom::instantiateEntry()
+{
+    return std::shared_ptr<ReplacementData>(new HPDcacheRandomReplData());
+}
+
+} // namespace replacement_policy
+} // namespace gem5
