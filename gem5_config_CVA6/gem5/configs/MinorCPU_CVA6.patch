index 0000000..16c9475
--- /dev/null
+++ b/src/mem/axi2mem_port.cc
@@ -0,0 +1,316 @@
+/*
+ * Copyright (c) 2026 Manuel Nieto
+ * All rights reserved.
+ *
+ * Redistribution and use in source and binary forms, with or without
+ * modification, are permitted provided that the following conditions are
+ * met: redistributions of source code must retain the above copyright
+ * notice, this list of conditions and the following disclaimer;
+ * redistributions in binary form must reproduce the above copyright
+ * notice, this list of conditions and the following disclaimer in the
+ * documentation and/or other materials provided with the distribution;
+ * neither the name of the copyright holders nor the names of its
+ * contributors may be used to endorse or promote products derived from
+ * this software without specific prior written permission.
+ *
+ * THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS
+ * "AS IS" AND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT
+ * LIMITED TO, THE IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR
+ * A PARTICULAR PURPOSE ARE DISCLAIMED. IN NO EVENT SHALL THE COPYRIGHT
+ * OWNER OR CONTRIBUTORS BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL,
+ * SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT
+ * LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE,
+ * DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY
+ * THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT
+ * (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE
+ * OF THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.
+ */
+
+/* Implementation, rules in axi2mem_port.hh. Retry follows Bridge and the
+ * transparent relay follows CommMonitor, both from gem5 v25.0.0.1.
+ */
+
+#include "mem/axi2mem_port.hh"
+
+#include <algorithm>
+
+#include "base/intmath.hh"
+#include "base/logging.hh"
+#include "base/trace.hh"
+#include "debug/Axi2MemPort.hh"
+#include "sim/cur_tick.hh"
+
+namespace gem5
+{
+
+/* Beat width in bytes, rule R6. AXI_DATA_WIDTH is 64 at the axi2mem
+ * instantiation (ariane_testharness.sv lines 32 and 456). Transcription
+ * constant, not a parameter. */
+static constexpr unsigned beatBytes = 8;
+
+Axi2MemPort::Axi2MemPort(const Params &params)
+    : ClockedObject(params),
+      memSidePort(name() + ".mem_side", *this),
+      cpuSidePort(name() + ".cpu_side", *this),
+      pendingRead(nullptr),
+      pendingReadArrival(0),
+      pendingWrite(nullptr),
+      pendingWriteArrival(0),
+      portBusy(false),
+      retryReq(false),
+      waitingForDownstreamRetry(false),
+      releaseEvent([this]{ release(); }, name()),
+      stats(this)
+{
+}
+
+void
+Axi2MemPort::init()
+{
+    if (!cpuSidePort.isConnected() || !memSidePort.isConnected())
+        fatal("Axi2MemPort %s must be connected on both sides\n", name());
+
+    // Announce the downstream ranges upstream, as Bridge does at init.
+    cpuSidePort.sendRangeChange();
+}
+
+Port &
+Axi2MemPort::getPort(const std::string &if_name, PortID idx)
+{
+    if (if_name == "mem_side") {
+        return memSidePort;
+    } else if (if_name == "cpu_side") {
+        return cpuSidePort;
+    } else {
+        return ClockedObject::getPort(if_name, idx);
+    }
+}
+
+Axi2MemPort::TxnClass
+Axi2MemPort::classify(const PacketPtr pkt)
+{
+    // An AR transaction: a read that expects data back on R.
+    if (pkt->isRead() && pkt->needsResponse())
+        return TxnClass::Read;
+
+    // An AW plus W transaction. Covers WritebackDirty, which needs no gem5
+    // response and ends at the port, and uncached WriteReq, whose response
+    // passes back through transparently.
+    if (pkt->isWrite() && pkt->hasData())
+        return TxnClass::Write;
+
+    // No AXI equivalent. CleanEvict carries no data and no response, and the
+    // HPDcache write-back configuration drops clean victims silently, so
+    // charging occupancy would invent traffic the RTL never issues.
+    return TxnClass::None;
+}
+
+Cycles
+Axi2MemPort::occupancy(const PacketPtr pkt) const
+{
+    // Rules R3 and R4: the read spends its extra cycle on the IDLE accept
+    // plus the SRAM round trip, the write on SEND_B, and both land on 1 + N.
+    // Rule R5 covers the streaming-beat assumption.
+    const unsigned beats =
+        std::max<unsigned>(1, divCeil(pkt->getSize(), beatBytes));
+    return Cycles(1 + beats);
+}
+
+bool
+Axi2MemPort::recvTimingReq(PacketPtr pkt)
+{
+    assert(pkt->isRequest());
+    panic_if(pkt->cacheResponding(),
+             "Axi2MemPort should not see packets where a cache is "
+             "responding\n");
+
+    const TxnClass cls = classify(pkt);
+
+    if (cls == TxnClass::None) {
+        DPRINTF(Axi2MemPort, "Forwarding %s addr %#x with no occupancy\n",
+                pkt->cmdString(), pkt->getAddr());
+        stats.passThrough++;
+        xmitList.push_back(pkt);
+        trySendDownstream();
+        return true;
+    }
+
+    if (cls == TxnClass::Read) {
+        if (pendingRead) {
+            DPRINTF(Axi2MemPort, "Refusing %s addr %#x, read slot full\n",
+                    pkt->cmdString(), pkt->getAddr());
+            retryReq = true;
+            return false;
+        }
+        pendingRead = pkt;
+        pendingReadArrival = curTick();
+    } else {
+        if (pendingWrite) {
+            DPRINTF(Axi2MemPort, "Refusing %s addr %#x, write slot full\n",
+                    pkt->cmdString(), pkt->getAddr());
+            retryReq = true;
+            return false;
+        }
+        pendingWrite = pkt;
+        pendingWriteArrival = curTick();
+    }
+
+    arbitrate();
+    return true;
+}
+
+void
+Axi2MemPort::arbitrate()
+{
+    // Rule R1: an occupied port admits nothing. The release event
+    // re-arbitrates the moment the occupancy window ends.
+    if (portBusy)
+        return;
+
+    // Rule R2: the RTL IDLE state tests ar_valid (axi2mem.sv line 129)
+    // before aw_valid (line 144), a fixed read priority.
+    if (pendingRead) {
+        PacketPtr pkt = pendingRead;
+        pendingRead = nullptr;
+        const Cycles waited = ticksToCycles(curTick() - pendingReadArrival);
+        stats.readsAdmitted++;
+        stats.readWaitCycles.sample(waited);
+        DPRINTF(Axi2MemPort,
+                "Admitting %s addr %#x size %u, occupancy %u cycles, "
+                "waited %u cycles\n", pkt->cmdString(), pkt->getAddr(),
+                pkt->getSize(), (unsigned)occupancy(pkt), (unsigned)waited);
+        admit(pkt);
+    } else if (pendingWrite) {
+        PacketPtr pkt = pendingWrite;
+        pendingWrite = nullptr;
+        const Cycles waited = ticksToCycles(curTick() - pendingWriteArrival);
+        stats.writesAdmitted++;
+        stats.writeWaitCycles.sample(waited);
+        DPRINTF(Axi2MemPort,
+                "Admitting %s addr %#x size %u, occupancy %u cycles, "
+                "waited %u cycles\n", pkt->cmdString(), pkt->getAddr(),
+                pkt->getSize(), (unsigned)occupancy(pkt), (unsigned)waited);
+        admit(pkt);
+    } else {
+        return;
+    }
+
+    // Admission freed a slot, so a refused sender can try again. A packet of
+    // the still-occupied class is refused once more and the flag raised
+    // again, which makes progress on every release and cannot deadlock.
+    if (retryReq) {
+        retryReq = false;
+        cpuSidePort.sendRetryReq();
+    }
+}
+
+void
+Axi2MemPort::admit(PacketPtr pkt)
+{
+    portBusy = true;
+
+    // Rule R7: the occupancy window ends exactly at the next accept
+    // opportunity, so a 2-beat transaction is admitted every 3 cycles at
+    // most. clockEdge quantises to the inherited 50 MHz domain.
+    schedule(releaseEvent, clockEdge(occupancy(pkt)));
+
+    // Forward in the same tick as admission. The uncontended path adds
+    // zero latency by construction, so response timing stays on the
+    // calibrated route through the crossbar and the memory controller.
+    xmitList.push_back(pkt);
+    trySendDownstream();
+}
+
+void
+Axi2MemPort::release()
+{
+    assert(portBusy);
+    portBusy = false;
+    arbitrate();
+}
+
+void
+Axi2MemPort::trySendDownstream()
+{
+    if (waitingForDownstreamRetry)
+        return;
+
+    while (!xmitList.empty()) {
+        PacketPtr pkt = xmitList.front();
+        if (!memSidePort.sendTimingReq(pkt)) {
+            waitingForDownstreamRetry = true;
+            return;
+        }
+        xmitList.pop_front();
+    }
+}
+
+void
+Axi2MemPort::recvReqRetry()
+{
+    waitingForDownstreamRetry = false;
+    trySendDownstream();
+}
+
+bool
+Axi2MemPort::recvTimingResp(PacketPtr pkt)
+{
+    // The response path is fully transparent, including flow control. In the
+    // RTL the R beats and the B handshake already live inside the occupancy
+    // of rules R3 and R4.
+    return cpuSidePort.sendTimingResp(pkt);
+}
+
+void
+Axi2MemPort::recvRespRetry()
+{
+    memSidePort.sendRetryResp();
+}
+
+Tick
+Axi2MemPort::recvAtomic(PacketPtr pkt)
+{
+    return memSidePort.sendAtomic(pkt);
+}
+
+void
+Axi2MemPort::recvFunctional(PacketPtr pkt)
+{
+    memSidePort.sendFunctional(pkt);
+}
+
+AddrRangeList
+Axi2MemPort::getAddrRanges() const
+{
+    return memSidePort.getAddrRanges();
+}
+
+void
+Axi2MemPort::recvRangeChange()
+{
+    cpuSidePort.sendRangeChange();
+}
+
+Axi2MemPort::Axi2MemPortStats::Axi2MemPortStats(statistics::Group *parent)
+    : statistics::Group(parent),
+      ADD_STAT(readsAdmitted, statistics::units::Count::get(),
+               "Read transactions admitted to the single port"),
+      ADD_STAT(writesAdmitted, statistics::units::Count::get(),
+               "Write transactions admitted to the single port"),
+      ADD_STAT(passThrough, statistics::units::Count::get(),
+               "Packets with no AXI equivalent forwarded without occupancy"),
+      ADD_STAT(readWaitCycles, statistics::units::Cycle::get(),
+               "Admission wait of read transactions"),
+      ADD_STAT(writeWaitCycles, statistics::units::Cycle::get(),
+               "Admission wait of write transactions")
+{
+    readWaitCycles
+        .init(8)
+        .flags(statistics::pdf);
+
+    writeWaitCycles
+        .init(8)
+        .flags(statistics::pdf);
+}
+
+} // namespace gem5
