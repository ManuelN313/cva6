+void
+BaseCache::fenceFlush()
+{
+    // Rule F3: the walk writes back dirty lines and clears their dirty bit,
+    // leaving them valid, which is what writebackVisitor already does. A
+    // flush is not an invalidate (hpdcache_cmo.sv lines 409 to 417).
+    unsigned dirty = 0;
+    unsigned lines = 0;
+    tags->forEachBlk([this, &dirty, &lines](CacheBlk &blk) {
+        lines++;
+        if (blk.isSet(CacheBlk::DirtyBit)) {
+            dirty++;
+        }
+        writebackVisitor(blk);
+    });
+    stats.fenceFlushes++;
+    stats.fenceFlushWritebacks += dirty;
