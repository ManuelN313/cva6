+# Axi2MemPort: transaction-level transcription of the CVA6 testbench memory
+# adapter (axi2mem.sv). Single-ported, one transaction at a time, read
+# priority, 1 + N cycles for N beats of 8 bytes. No tunable parameters.
+
+from m5.objects.ClockedObject import ClockedObject
+from m5.params import *
+
+
+class Axi2MemPort(ClockedObject):
+    type = "Axi2MemPort"
+    cxx_header = "mem/axi2mem_port.hh"
+    cxx_class = "gem5::Axi2MemPort"
+
+    cpu_side = ResponsePort(
+        "Receives requests from the system crossbar and sends responses"
+    )
+    mem_side = RequestPort(
+        "Sends requests to the memory controller and receives responses"
+    )
