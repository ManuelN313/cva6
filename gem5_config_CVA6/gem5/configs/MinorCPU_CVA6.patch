+ * SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT
+ * LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE,
+ * DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY
+ * THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT
+ * (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE
+ * OF THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.
+ */
+
+/*
+ * Axi2MemPort: a transaction-level transcription of the CVA6 testbench
+ * memory adapter (axi2mem.sv) for gem5.
+ *
+ * The object sits between the system crossbar and the memory controller
+ * and reproduces the single-ported, one-transaction-at-a-time behaviour
+ * of the AXI-to-SRAM adapter in ariane_testharness.sv. Every behaviour
+ * is a transcription of an RTL rule, cited at the point of use with
+ * rule numbers R1 to R8. There are no tunable parameters. The
+ * clock is inherited from the parent clock domain, which in the CVA6
+ * configuration is the 50 MHz board domain.
+ *
+ * Summary of the transcribed rules:
+ *   R1  one transaction holds the port end to end (axi2mem.sv line 56,
+ *       FSM {IDLE, READ, WRITE, SEND_B, WAIT_WVALID})
+ *   R2  fixed read priority in IDLE (line 129 tested before line 144)
+ *   R3  read occupancy is 1 + N cycles for N beats (lines 124 to 220)
+ *   R4  write occupancy is 1 + N cycles for N beats (lines 144 to 265)
+ *   R6  N is payload bytes over 8, AXI_DATA_WIDTH = 64
+ *       (ariane_testharness.sv lines 32 and 456)
+ *   R7  the IDLE cycle is itself the next accept cycle, no dead cycle
+ *
+ * Uncontended latency added by this object is exactly zero. A packet
+ * that finds its class slot free and the port idle is forwarded
+ * downstream in the same tick it arrives. Contention appears only as
+ * admission wait, so runs without overlapping memory traffic are
+ * bit-identical to runs without the object.
+ */
+
+#ifndef __MEM_AXI2MEM_PORT_HH__
+#define __MEM_AXI2MEM_PORT_HH__
+
+#include <deque>
+
+#include "base/statistics.hh"
+#include "base/types.hh"
+#include "mem/port.hh"
+#include "params/Axi2MemPort.hh"
+#include "sim/clocked_object.hh"
+
+namespace gem5
+{
+
+class Axi2MemPort : public ClockedObject
+{
+  public:
+    using Params = Axi2MemPortParams;
+
+    Axi2MemPort(const Params &params);
+
+    void init() override;
+
+    Port &getPort(const std::string &if_name,
+                  PortID idx = InvalidPortID) override;
+
+  private:
+    /** Packet classification against the AXI transactions the RTL adapter
+     * would see. Read maps to AR, Write to AW plus W, and None to packets
+     * with no AXI equivalent, such as CleanEvict. */
+    enum class TxnClass { Read, Write, None };
+
+    /** The port facing the memory controller. */
+    class ModelRequestPort : public RequestPort
+    {
+      public:
+        ModelRequestPort(const std::string &_name, Axi2MemPort &_adapter)
+            : RequestPort(_name), adapter(_adapter)
+        { }
+
+      protected:
+        bool
+        recvTimingResp(PacketPtr pkt)
+        {
+            return adapter.recvTimingResp(pkt);
+        }
+
+        void
+        recvReqRetry()
+        {
+            adapter.recvReqRetry();
+        }
+
+        void
+        recvRangeChange()
+        {
+            adapter.recvRangeChange();
+        }
+
+      private:
+        Axi2MemPort &adapter;
+    };
+
+    /** The port facing the system crossbar. */
+    class ModelResponsePort : public ResponsePort
+    {
+      public:
+        ModelResponsePort(const std::string &_name, Axi2MemPort &_adapter)
+            : ResponsePort(_name), adapter(_adapter)
+        { }
+
+      protected:
+        void
+        recvFunctional(PacketPtr pkt)
+        {
+            adapter.recvFunctional(pkt);
+        }
+
+        Tick
+        recvAtomic(PacketPtr pkt)
+        {
+            return adapter.recvAtomic(pkt);
+        }
+
+        bool
+        recvTimingReq(PacketPtr pkt)
+        {
+            return adapter.recvTimingReq(pkt);
+        }
+
+        AddrRangeList
+        getAddrRanges() const
+        {
+            return adapter.getAddrRanges();
+        }
+
+        void
+        recvRespRetry()
+        {
+            adapter.recvRespRetry();
+        }
+
+      private:
+        Axi2MemPort &adapter;
+    };
+
+    ModelRequestPort memSidePort;
+    ModelResponsePort cpuSidePort;
+
+    /** Relay targets called by the two ports. */
+    void recvFunctional(PacketPtr pkt);
+    Tick recvAtomic(PacketPtr pkt);
+    bool recvTimingReq(PacketPtr pkt);
+    bool recvTimingResp(PacketPtr pkt);
+    void recvReqRetry();
+    void recvRespRetry();
+    void recvRangeChange();
+    AddrRangeList getAddrRanges() const;
+
+    /** Classify a packet against the RTL transaction classes. */
+    static TxnClass classify(const PacketPtr pkt);
+
+    /** Port occupancy of an admitted transaction, rules R3, R4 and R6.
+     * Both classes occupy 1 + N cycles for N beats of 8 bytes. */
+    Cycles occupancy(const PacketPtr pkt) const;
+
+    /** Admission arbitration, rule R2. Called whenever the port frees or a
+     * request arrives. Admits the pending read before the pending write, as
+     * the RTL IDLE state tests ar_valid before aw_valid. */
+    void arbitrate();
+
+    /** Admit one transaction: occupy the port and forward downstream. */
+    void admit(PacketPtr pkt);
+
+    /** The port becomes free, rule R7: this tick can admit again. */
+    void release();
+
+    /** Drain the downstream transmit list, honouring peer flow control. */
+    void trySendDownstream();
+
+    /** One pending slot per transaction class, mirroring the separate AR and
+     * AW channels. A flat single-slot refusal would head-block a read behind
+     * a refused write, and rule R2 would become untranscribable. */
+    PacketPtr pendingRead;
+    Tick pendingReadArrival;
+    PacketPtr pendingWrite;
+    Tick pendingWriteArrival;
+
+    /** The single port is occupied, rule R1. */
+    bool portBusy;
+
+    /** An upstream sender was refused and is owed a retry. */
+    bool retryReq;
+
+    /** The downstream peer refused and owes this object a retry. */
+    bool waitingForDownstreamRetry;
+
+    /** Admitted packets awaiting the downstream handshake, in order. */
+    std::deque<PacketPtr> xmitList;
+
+    /** Fires when the occupancy window of the transaction ends. */
+    EventFunctionWrapper releaseEvent;
+
+    struct Axi2MemPortStats : public statistics::Group
+    {
+        Axi2MemPortStats(statistics::Group *parent);
+
+        /** Transactions admitted per class. */
+        statistics::Scalar readsAdmitted;
+        statistics::Scalar writesAdmitted;
+
+        /** Packets forwarded with no AXI equivalent and no occupancy. */
+        statistics::Scalar passThrough;
+
+        /** Admission wait per class in cycles. The write histogram is the
+         * gem5 twin of the CVA6 baseline writeback latency tail. */
+        statistics::Histogram readWaitCycles;
+        statistics::Histogram writeWaitCycles;
+    } stats;
+};
+
+} // namespace gem5
+
+#endif // __MEM_AXI2MEM_PORT_HH__
