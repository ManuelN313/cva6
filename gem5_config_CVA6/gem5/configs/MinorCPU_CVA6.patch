+CacheBlk*
+BaseCache::reserveVictimInPlace(const PacketPtr pkt, PacketList &writebacks,
+                                bool &dirty_victim)
+{
+    const Addr addr = pkt->getAddr();
+    const bool is_secure = pkt->isSecure();
+    const auto partition_id = partitionManager ?
+        partitionManager->readPacketPartitionID(pkt) : 0;
+
+    std::vector<CacheBlk*> evict_blks;
+    CacheBlk *victim = tags->findVictim({addr, is_secure}, blkSize*8,
+                                        evict_blks, partition_id);
+    if (!victim) {
+        return nullptr;
+    }
+
+    // Only the plain single-victim case is modelled. Compression can
+    // co-evict several blocks for one insertion, which has no
+    // counterpart in the HPDcache, so fall back rather than guess.
+    if (evict_blks.size() != 1 || evict_blks[0] != victim) {
+        return nullptr;
+    }
+    if (!victim->isValid()) {
+        // A free way. Nothing to keep readable, so let the stock
+        // allocation path handle this miss.
+        return nullptr;
+    }
+    // Never take a block that is already spoken for, either as
+    // another miss's in-place victim or through a pending
+    // transaction of its own.
+    if (victim->isReservedVictim()) {
+        return nullptr;
+    }
+    if (mshrQueue.findMatch(regenerateBlkAddr(victim),
+                            victim->isSecure())) {
+        // The same test handleEvictions applies, kept identical so
+        // the in-place path refuses exactly what the stock path
+        // refuses.
+        return nullptr;
+    }
+
+    // Flush the victim now if it is dirty, as the miss handler does at MSHR
+    // allocation, but leave the block valid and readable. The writeback
+    // clears the dirty bit, so its data still answers hits until the refill.
+    if (victim->isSet(CacheBlk::DirtyBit)) {
+        dirty_victim = true;
+        writebacks.push_back(writebackBlk(victim));
+    } else if (!writebackClean) {
+        // Preserve the eviction traffic the stock path would have
+        // produced at this instant, unchanged in kind and timing.
+        PacketPtr clean_evict = cleanEvictBlk(victim);
+        if (clean_evict) {
+            writebacks.push_back(clean_evict);
+        }
+    }
+
+    // handleEvictions is bypassed on this path, and it is where gem5
+    // counts a valid block being displaced. Count it here so the stat
+    // keeps its meaning under the lever.
+    stats.replacements++;
+
+    victim->setReservedVictim();
+    return victim;
+}
+
+CacheBlk*
+BaseCache::consumeReservation(const PacketPtr pkt, MSHR *mshr,
+                              PacketList &writebacks)
+{
+    CacheBlk *victim = mshr->reservedBlk;
+    assert(victim && victim->isReservedVictim());
+
+    // The victim was flushed when it was reserved, but a store may
+    // have hit it in the meantime, so check before dropping the data.
+    if (victim->isSet(CacheBlk::DirtyBit)) {
+        stats.reservationRedirties++;
+        writebacks.push_back(writebackBlk(victim));
+    }
+
+    victim->clearReservedVictim();
+    invalidateBlock(victim);
+    tags->insertBlock(pkt, victim);
+    victim->setWhenReady(curTick());
+    return victim;
+}
+
+void
+BaseCache::reserveOnAllocate(const PacketPtr pkt, MSHR *mshr,
+                             Tick forward_time)
+{
+    // Rules E1 and E2: victim selection, tag insertion and the dirty victim
+    // writeback all happen at MSHR allocation time, mirroring
+    // mshr_alloc_wback in the HPDcache miss pipeline.
+    PacketList writebacks;
+    bool dirty_victim = false;
+    CacheBlk *blk;
+
+    if (victimReadableUntilFill) {
+        // The victim keeps its line and stays readable until the
+        // refill consumes it, which is what the HPDcache data array
+        // does. Selection and the dirty flush still happen now.
+        blk = reserveVictimInPlace(pkt, writebacks, dirty_victim);
+        if (!blk) {
+            stats.reservationFallbacks++;
+            return;
+        }
+        stats.inPlaceReservations++;
+    } else {
+        blk = allocateBlock(pkt, writebacks);
+        if (!blk) {
+            // No victim could be freed, for instance because the
+            // chosen victim has a pending transaction of its own.
+            // Fall back to the stock fill-time allocation.
+            stats.reservationFallbacks++;
+            return;
+        }
+
+        assert(!blk->isSet(CacheBlk::ReadableBit));
+        assert(!blk->isSet(CacheBlk::WritableBit));
+
+        // The data is not present until the refill lands and ReadableBit
+        // keeps every consumer away. Pointing whenReady at now mirrors the
+        // stock write-miss transient and adds no latency.
+        blk->setWhenReady(curTick());
+
+        for (const auto &wb : writebacks) {
+            if (wb->cmd == MemCmd::WritebackDirty) {
+                dirty_victim = true;
+            }
+        }
+    }
+
+    mshr->reservedBlk = blk;
+    stats.earlyReservations++;
+
+    doWritebacks(writebacks, forward_time);
+
+    if (victimReadoutStall && dirty_victim) {
+        // Rules E3 and E6: the dirty victim readout holds the array
+        // blkSize/8 cycles, hits and misses alike. A store trigger
+        // adds the rtab replay, window-law class z (+6 over loads).
+        const bool store_trig =
+            mshr->hasTargets() && mshr->getTarget()->pkt->isWrite();
+        // Minor serialises demand-load misses, so a concurrent
+        // load miss, the y condition, cannot occur and every
+        // load-triggered window is class x, the law's +3 over 2.
+        const bool first_load = !store_trig;
+        const Cycles readout(blkSize / 8 +
+            (store_trig ? uint64_t(victimReadoutStoreExtra) :
+             first_load ? uint64_t(victimReadoutFirstLoadExtra) : 0));
+        const Tick until = clockEdge(readout);
+        if (windowAcceptAndCharge) {
+            // The trigger takes the whole window on its own fill and the
+            // window stays open for the overlap of anything arriving
+            // before it closes. The cpu side is never blocked.
+            mshr->windowCharge = readout;
+            stats.windowTriggerCharges++;
+            stats.windowTriggerCycles += readout;
+            DPRINTF(Cache, "Window trigger charged %d cycles to %s addr %#x\n",
+                    uint64_t(readout), store_trig ? "store" : "load",
+                    mshr->blkAddr);
+            victimReadoutWindowEnd = std::max(victimReadoutWindowEnd, until);
+        } else if (victimReadoutClearEvent.scheduled()) {
+            reschedule(victimReadoutClearEvent, until);
+        } else {
+            setBlocked(Blocked_VictimReadout);
+            schedule(victimReadoutClearEvent, until);
+        }
+    }
+}
